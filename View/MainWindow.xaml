<Window x:Class="CW.FreelanceWork.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Height="600" Width="1000"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Consolas"
        MouseDown="Window_MouseDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Background gradient -->
        <Rectangle Grid.RowSpan="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A0E06" Offset="0"/>
                    <GradientStop Color="#3B2410" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Top bar -->
        <StackPanel Background="#4D3825"/>

        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="15 0 0 0"
                   FontSize="18"
                   FontWeight="SemiBold">
            <Run Foreground="White">Практическая работа 8  |  Фриланс Биржа  |  </Run>
            <Run Foreground="#D4A84F" TextDecorations="Underline" Cursor="Hand"
                 ToolTip="Курсовая работа по ТРПО">Работа Всем</Run>
        </TextBlock>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 10 0">
            <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                    ToolTip="Закрыть приложение"
                    x:Name="BtnClose"
                    Click="BtnClose_Click">
                <materialDesign:PackIcon Kind="Power" Foreground="#D4A84F" Width="22" Height="22"/>
            </Button>
        </StackPanel>

        <!-- Main content frame -->
        <Frame Grid.Row="1"
               x:Name="MainWindowFrame"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
