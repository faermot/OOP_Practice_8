<Page x:Class="CW.FreelanceWork.View.Pages.EmployerPage.DetailEmployerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="1000"
      FontFamily="Consolas">

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="20" Width="580" Height="420"
                Background="#4D3825"
                Effect="{StaticResource MaterialDesignElevationShadow16}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- Header with notification badge -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Форма размещения заказа"
                               FontSize="20" TextWrapping="Wrap" Width="450"
                               Foreground="White" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <materialDesign:Badged Badge="3" HorizontalAlignment="Right"
                                          VerticalAlignment="Top" Margin="0 6 16 0">
                        <Button Background="#D4A84F" Foreground="White"
                                BorderThickness="0" Height="30" Width="30"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Padding="0"
                                ToolTip="У Вас 3 уведомления">
                            <materialDesign:PackIcon Kind="Bell" Width="16" Height="16"/>
                        </Button>
                    </materialDesign:Badged>
                </Grid>

                <!-- Form fields -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0 8 0 0">

                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                        <materialDesign:PackIcon Kind="FileDocumentEdit" Margin="0 10 6 0" Foreground="#D4A84F"/>
                        <TextBox x:Name="TbTitle" Width="280" FontSize="14"
                                 Foreground="#D4A84F"
                                 materialDesign:HintAssist.Hint="Введите заголовок заказа"
                                 materialDesign:TextFieldAssist.HasClearButton="True"/>
                    </StackPanel>

                    <!-- Deadline -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                        <materialDesign:PackIcon Kind="Timer" Margin="0 10 6 0" Foreground="#D4A84F"/>
                        <TextBox x:Name="TbTime" Width="280" FontSize="14"
                                 Foreground="#D4A84F"
                                 materialDesign:HintAssist.Hint="Введите сроки исполнения"
                                 materialDesign:TextFieldAssist.HasClearButton="True"/>
                    </StackPanel>

                    <!-- Files (disabled, admin only) -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                        <materialDesign:PackIcon Kind="Paperclip" Margin="0 10 6 0" Foreground="#D4A84F"/>
                        <TextBox Width="280" FontSize="14" IsEnabled="False"
                                 Foreground="#D4A84F"
                                 materialDesign:HintAssist.Hint="Добавьте файлы к заказу"
                                 ToolTip="Доступно после проверки администратором"/>
                    </StackPanel>

                    <!-- Order description -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                        <materialDesign:PackIcon Kind="OrderBoolAscending" Margin="0 10 6 0" Foreground="#D4A84F"/>
                        <TextBox x:Name="TbOrder" Width="280" Height="70"
                                 FontSize="14" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Foreground="#D4A84F"
                                 VerticalScrollBarVisibility="Auto"
                                 materialDesign:HintAssist.Hint="Добавьте описание заказа"
                                 materialDesign:TextFieldAssist.HasClearButton="True"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnCheck" Click="BtnCheck_Click"
                            Background="#D4A84F" Foreground="White"
                            BorderThickness="0" Margin="0 0 12 0"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCog" Margin="0 0 5 0"/>
                            <TextBlock Text="Отправить на согласование" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnBack" Click="BtnBack_Click"
                            Background="#D4A84F" Foreground="White"
                            BorderThickness="0"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Margin="0 0 5 0"/>
                            <TextBlock Text="Выйти" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
