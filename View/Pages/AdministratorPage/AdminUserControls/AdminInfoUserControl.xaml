<UserControl x:Class="CW.FreelanceWork.View.Pages.AdministratorPage.AdminUserControls.AdminInfoUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="960"
             FontFamily="Consolas">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
            <DataGrid x:Name="DataUserInfo"
                      FontSize="13" Height="400" Width="950"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="False"
                      Background="#D4A84F" RowBackground="White"
                      AlternatingRowBackground="#FFF0F0"
                      GridLinesVisibility="Horizontal"
                      ColumnHeaderHeight="44"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      Effect="{StaticResource MaterialDesignElevationShadow16}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Header="ФИО"
                                       Binding="{Binding FIO}" FontSize="13"/>
                    <DataGridTextColumn Width="*" Header="МОБ. НОМЕР"
                                       Binding="{Binding UserPhone}" FontSize="13"/>
                    <DataGridTextColumn Width="*" Header="ЭЛЕКТРОННАЯ ПОЧТА"
                                       Binding="{Binding UserMail}" FontSize="13"/>
                    <DataGridTextColumn Width="*" Header="НАВЫКИ"
                                       Binding="{Binding UserSkills}" FontSize="13"/>
                    <DataGridTemplateColumn Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="BtnDelete" Click="BtnDelete_Click"
                                        Background="#D4A84F" Foreground="#4D3825"
                                        ToolTip="Удалить пользователя"
                                        BorderBrush="#D4A84F"
                                        Style="{StaticResource MaterialDesignFlatLightButton}"
                                        Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
